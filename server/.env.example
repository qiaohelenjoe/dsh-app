# 服务端环境变量示例（复制为 .env 后按需修改；.env 不入库）
# PostgreSQL 16 连接串（必填）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
# 监听地址与端口（默认 127.0.0.1:8787，供 nginx 反代）
HOST=127.0.0.1
PORT=8787
# JWT 签名密钥（必填，>=32 位，生产用随机串）
AUTH_JWT_SECRET=change-me-to-a-random-32-chars-secret
# refresh / 一次性令牌哈希的 pepper（必填，>=16 位）
AUTH_REFRESH_PEPPER=change-me-random-pepper
# access token 有效期（秒）与 refresh 有效期（天）
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 邮箱验证开关（规格 D3：默认关闭）
EMAIL_VERIFICATION_ENABLED=false
# 弱口令列表（默认 server/data/weak-passwords.txt，前 10 万）
# WEAK_PASSWORD_LIST_PATH=./data/weak-passwords.txt
# 对外基础地址（密码重置链接用）
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 设备码轮询最小间隔（秒）
DEVICE_CODE_POLL_INTERVAL_SECONDS=2
# 迁移目录（默认 server/migrations）
# MIGRATIONS_DIR=./migrations
# 测试用管理员连接串（仅测试使用，默认同上）
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

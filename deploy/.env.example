# 复制为 .env 后修改：cp .env.example .env
# 生产必须替换为随机值（>=32/>=16 字符），不要提交到 git
POSTGRES_PASSWORD=change-me-strong-random-password

AUTH_JWT_SECRET=change-me-random-32-chars-secret
AUTH_REFRESH_PEPPER=change-me-random-pepper

# 宿主机回环端口（nginx 反代目标；生产默认 8787）
SERVER_PORT=8787

# 对外基础地址（密码重置链接等使用）
PUBLIC_BASE_URL=https://dsh.hbzxht.com

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_ENABLED=false
DEVICE_CODE_POLL_INTERVAL_SECONDS=2
